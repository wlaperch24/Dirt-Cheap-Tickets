{
  "name": "dirt-cheap-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Speed-first single-operator ticket deal monitor",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @dct/gateway --filter @dct/core --filter @dct/connectors --filter @dct/detector --filter @dct/notifier dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "migrate": "pnpm --filter @dct/db migrate"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
